# Python
__pycache__/
*.pyc
*.pyo
.venv/
*.egg-info/

# Runtime output images
*.bmp
*.png
*.gif
*.mp4
# Exception: README screenshots in docs/
!docs/*.png
# Exception: golden-image regression references (checked in on purpose)
!tests/golden/*.png
# ...but not the actual-render dumps left behind by a failing golden test
tests/golden/_failures/

# Test output directory
output/

# Runtime data / cache
data/*.json
# Exception: generated stadium polygon dataset
!data/stadium_polygons.json
# Exception: outfield wall polygons (generated by generate_wall_polygons.py)
!data/mlbam_walls.json
# Exception: static stadium weather coordinates (lat/lon + roof type)
!data/stadium_weather.json
# Exception: hand-maintained Home Run Derby bracket (no API source; edited by hand)
!data/derby_bracket.json

# Environment
.env

# Coverage
.coverage
coverage.xml
htmlcov/

# Claude Code session data
.claude/
