[Unit]
Description=MLB Display Slack Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/mlb_display
EnvironmentFile=/home/pi/mlb_display/.env
ExecStart=/home/pi/.local/bin/poetry run python3 src/slack_bot.py
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
